definition {

	@summary = "Default summary"
	macro assertNoResendInvitationButton() {
		AssertElementNotPresent(locator1 = "MP2Dashboards#RESEND_INVITATION");
	}

	@summary = "Default summary"
	macro assertNotViewCustomerGatePage(title = null,) {
		AssertElementNotPresent(
			key_headerTitle = ${title},
			locator1 = "MP2Dashboards#HEADER_TITLE_CG");
	}

	@summary = "Default summary"
	macro assertResendInvitationButton() {
		AssertElementPresent(locator1 = "MP2Dashboards#RESEND_INVITATION");
	}

	@summary = "Default summary"
	macro clickBreadcrumb(accountTitle = null) {
		var key_accountTitle = ${accountTitle};

		Click(locator1 = "MP2Dashboards#SVG_DROPDOWN");

		Click(
			key_accountTitle = ${accountTitle},
			locator1 = "MP2Dashboards#SVG_DROPDOWN_OPTIONS",
			value1 = ${accountTitle});
	}

	@summary = "Default summary"
	macro clickNewMemberButton(buttonName = null) {
		Click(
			key_buttonName = ${buttonName},
			locator1 = "MP2Dashboards#ANY_DASHBOARD_BUTTON");
	}

	@summary = "Default summary"
	macro clickOnTheGetStartedButton() {
		Click(locator1 = "MP2Dashboards#GET_STARTED_BUTTON");
	}

	@summary = "Default summary"
	macro clickOnTheInvitedUser(label = null, value = null) {
		Click(
			key_label = ${label},
			key_text = ${value},
			locator1 = "MP2Dashboards#DASHBOARD_TABLE");
	}

	@summary = "Default summary"
	macro clickOnTheResendInvitationButton() {
		Click(locator1 = "MP2Dashboards#RESEND_INVITATION");

		Alert.viewSuccessMessage();
	}

	@summary = "Default summary"
	macro customerGateFlow(imageName = null, field = null,) {
		Click(locator1 = "MP2Dashboards#GET_STARTED_BUTTON");

		if (isSet(imageName)) {
			UploadCommonFile.uploadCommonFileHiddenNoMouseOver(
				key_field = ${field},
				locator1 = "MP2Dashboards#UPLOAD_FIELD",
				value1 = ${imageName});
		}

		if (!(isSet(checkboxName))) {
			var checkboxName = "";
		}

		Check.checkNotVisible(
			checkboxName = ${checkboxName},
			locator1 = "Checkbox#ANY_CHECKBOX");

		Button.click(button = "Next");

		WaitForElementPresent(
			key_navItem = "Members",
			locator1 = "MP2Navigation#NAV_ITEM");
	}

	@summary = "Default summary"
	macro inviteNewMember(firstName = null, lastName = null, emailAddress = null, checkboxName = null) {
		MP2Dashboards.clickNewMemberButton(buttonName = "New Member");

		WaitForPageLoad();

		MP2Dashboards.typeNewMemberInfoFields(
			field = "firstName",
			fieldInput = ${firstName});

		MP2Dashboards.typeNewMemberInfoFields(
			field = "lastName",
			fieldInput = ${lastName});

		MP2Dashboards.typeNewMemberInfoFields(
			field = "emailAddress",
			fieldInput = ${emailAddress});

		MP2Utils.selectCheckbox(checkboxName = ${checkboxName});

		if (isSet(button)) {
			Button.click(button = "Send Invite");
		}

		Alert.viewSuccessMessage();
	}

	@summary = "Default summary"
	macro typeNewMemberInfoFields(field = null, fieldInput = null) {
		Type(
			key_field = ${field},
			locator1 = "MP2Dashboards#SETUP_FIELDS",
			value1 = ${fieldInput});
	}

	@summary = "Default summary"
	macro viewNewMemberButtonNotPresent() {
		AssertElementNotPresent(locator1 = "MP2Dashboards#ANY_DASHBOARD_BUTTON");
	}

	@summary = "Add a new app via dashboard"
	macro addNewAppViaDashBoard() {
		Click(
			key_text = "New App",	
			locator1 = "Marketplace#ANY_BUTTON");

		Click(
			key_text = "Continue",	
			locator1 = "Marketplace#ANY_BUTTON");

		MP2Dashboards._fulfillAppProfileForm(
			appImage = ${appImage},
			categories = ${categories},
			description = ${description},
			name = ${name},
			tags = ${tags});
		
		Click(
			key_text = "Continue",	
			locator1 = "Marketplace#ANY_BUTTON");

		MP2Dashboards._fulfillAppBuildForm(
			cloudCompatibility = ${cloudCompatibility},
			compatibleOfferings = ${compatibleOfferings},
			zipFile = ${zipFile});
		
		Click(
			key_text = "Continue",	
			locator1 = "Marketplace#ANY_BUTTON");

		MP2Dashboards._fulfillAppStorefrontForm(table = ${storefrontImages});
		
		Click(
			key_text = "Continue",	
			locator1 = "Marketplace#ANY_BUTTON");
	}

	macro _fulfillAppProfileForm {
		UploadCommonFile.uploadCommonFileHiddenNoMouseOver(
			key_field = "file",
			locator1 = "MP2Dashboards#UPLOAD_FIELD",
			value1 = ${appImage});

		Type(
			key_inputLabel = "Name",
			locator1 = "MP2Dashboards#DASHBOARD_INPUT",
			value1 = ${name});

		Type(
			key_inputLabel = "Description",
			locator1 = "MP2Dashboards#DASHBOARD_INPUT",
			value1 = ${description});

		for (var categorie : list ${categories}) {
			Type.sendKeys(
				key_inputLabel = "Categories",
				locator1 = "MP2Dashboards#DASHBOARD_REACT_SELECT",
				value1 = ${categorie});

			KeyPress(
				key_inputLabel = "Categories",
				locator1 = "MP2Dashboards#DASHBOARD_REACT_SELECT",
				value1 = "\ENTER");
		}

		for (var tag : list ${tags}) {
			Type.sendKeys(
				key_inputLabel = "Tags",
				locator1 = "MP2Dashboards#DASHBOARD_REACT_SELECT",
				value1 = ${tag});

			KeyPress(
				key_inputLabel = "Tags",
				locator1 = "MP2Dashboards#DASHBOARD_REACT_SELECT",
				value1 = "\ENTER");
		}
	}

	macro _fulfillAppBuildForm {

		Click(
			key_titleText = ${cloudCompatibility},
			locator1 = "MP2Dashboards#DASHBOARD_RADIO_CARD_BUTTON");

		if(isSet(compatibleOfferings)) {
			for (var compatibleOffering : list ${compatibleOfferings}) {
				Check.checkNotVisible(
					key_checkboxLabel = ${compatibleOffering},
					locator1 = "MP2Dashboards#DASHBOARD_CHECKBOX");
			}
		}

		UploadCommonFile.uploadCommonFileHiddenNoMouseOver(
			key_field = "file",
			locator1 = "MP2Dashboards#UPLOAD_FIELD",
			value1 = ${zipFile});
	}

	macro _fulfillAppStorefrontForm {
		var rawTable = TableUtil.newTable(${table});

		for (var row : table ${rawTable}) {
			var storefrontImage = "${row[0]}";
			var storefrontImageDescription = "${row[1]}";

			echo("Imagem sendo upada: ${storefrontImage}");

			UploadCommonFile.uploadCommonFileHiddenNoMouseOver(
				key_field = "file",
				locator1 = "MP2Dashboards#UPLOAD_FIELD",
				value1 = ${storefrontImage});

			if(${storefrontImageDescription} != "") {
				Type(
					key_imageName = ${storefrontImage},
					locator1 = "MP2Dashboards#DASHBOARD_STOREFRONT_IMAGE_DESCRIPTION_TEXTBOX",
					value1 = ${storefrontImageDescription});
			}

			Click(locator1 = "//body");
		}
	}
}