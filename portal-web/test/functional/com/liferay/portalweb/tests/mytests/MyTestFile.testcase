@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		Navigator.openURL();
	}

	tearDown {
		User.logoutAndLoginPG(
			userLoginEmailAddress = "test@liferay.com",
			userLoginFullName = "Test Test");
	}

	@description = "Set Screen size to custom and validate values"
	@priority = 5
	test CanDefineDXPCustomScreenSize {
		MyTestFile.goToCustomScreen();

		MyTestFile.customHeight(
			customHeight = 11,
			customHeightTwo = 920);

		MyTestFile.customWidth(
			customWidth = 10,
			customWidthTwo = 080);

		MyTestFile.assertTheValuesApplied();
	}

}