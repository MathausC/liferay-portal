<html>
<head>
<title>MyTestFile</title>
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">MyTestFile</td></tr>
</thead>

<tbody>
<tr>
	<td>APPLY_CUSTOM_SIZE</td>
	<td>//button[@aria-label='Apply Custom Size']</td>
	<td></td>
</tr>
<tr>
	<td>ASSERT_VALUES</td>
	<td>//div[text()='Custom Size 1920x1080 Applied']</td>
	<td></td>
</tr>
<tr>
	<td>CLOSE_BUTTON</td>
	<td>//button[contains(@class,'btn btn-monospaced') and @aria-label='Close']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOM_HEIGHT</td>
	<td>//input[contains(@id,'height')]</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOM_SCREEN</td>
	<td>//span[text()='Custom']</td>
	<td></td>
</tr>
<tr>
	<td>CUSTOM_WIDTH</td>
	<td>//input[contains(@id,'width')]</td>
	<td></td>
</tr>
<tr>
	<td>OPEN_SIMULATION</td>
	<td>//button[@data-qa-id='simulation']</td>
	<td></td>
</tr>
</tbody>
</table>
</body>
</html>