@component-name = "portal-lima"
definition {

	property testray.main.component.name = "Blogs";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Blogs Page");

		JSONLayout.addWidgetToPublicLayout(
			column = 1,
			groupName = "Guest",
			layoutName = "Blogs Page",
			widgetName = "Blogs");

		Navigator.gotoPage(pageName = "Blogs Page");
	}

	tearDown {
		var testLiferayVirtualInstance = PropsUtil.get("test.liferay.virtual.instance");

		if (${testLiferayVirtualInstance} == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			BlogsEntry.tearDownCP();

			Blogs.tearDownConfigurationDisplaySettingsPG(
				pageName = "Blogs Page",
				portletName = "Blogs");

			Blogs.tearDownConfigurationScopePG(
				pageName = "Blogs Page",
				portletName = "Blogs");

			PagesAdmin.tearDownCP();

			Site.tearDownCP();

			Organization.tearDownCP();

			JSONUser.tearDownNonAdminUsers();

			ServerAdministration.tearDownMailServerSettings();
		}
	}

	@description = "Can Create a Blog"
	@priority = 5
	test CanCreateBlog {
		task ("Given the creation of a new blog") {
			BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");
		}

		task ("When the user adds a Blog Entry") {
			Blogs.addEntry(
				entryContent = "Blogs SDG Content",
				entryTitle = "Blogs SDG Title");
		}

		task ("Then the Blog Entry should display on the page") {
			Navigator.gotoPage(pageName = "Blogs Page");

			BlogsEntry.viewPG(
				entryContent = "Blogs SDG Content",
				entryTitle = "Blogs SDG Title");
		}
	}

	@description = "Can Delete a Blog"
	@priority = 5
	test CanDeleteBlog {
		task ("Given the creation of a new blog") {
			BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");
		}

		task ("And Two Blog Entries exists") {
			Blogs.addEntry(
				entryContent = "CE3235",
				entryTitle = "CE");

			Blogs.addEntry(
				entryContent = "DXP3536",
				entryTitle = "DXP");

			Navigator.gotoPage(pageName = "Blogs Page");

			BlogsEntry.viewPG(
				entryContent = "CE3235",
				entryTitle = "CE");

			BlogsEntry.viewPG(
				entryContent = "DXP3536",
				entryTitle = "DXP");
		}

		task ("When the User deletes Blog Entry 1") {
			for (var entryCount : list 1) {
				BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");

				BlogsNavigator.moveToRecycleBinCP(
					assetType = "Blogs Entry",
					entryTitle = "CE");
			}
		}

		task ("Then Blog Entry 1 should not exist And Blog Entry 2 should exist") {
			Navigator.gotoPage(pageName = "Blogs Page");

			BlogsEntry.viewPG(
				entryContent = "DXP3536",
				entryTitle = "DXP");
		}
	}

	@description = "Can Edit a Blog"
	@priority = 5
	test CanEditBlog {
		task ("Given the creation of a new blog") {
			BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");
		}

		task ("And a Blog Entry exists") {
			Blogs.addEntry(
				entryContent = "Blogs SDG Content",
				entryTitle = "Blogs SDG Title");

			Navigator.gotoPage(pageName = "Blogs Page");
		}

		task ("When the User edits the blog Entry") {
			Blogs.editEntryPG(
				entryContent = "Blogs SDG Content",
				entryContentEdit = "Blogs SDG Content Edited",
				entryTitle = "Blogs SDG Title",
				entryTitleEdit = "Blogs SDG Title Edited");
		}

		task ("Then the Blog Entry should be edited") {
			Navigator.gotoPage(pageName = "Blogs Page");

			BlogsNavigator.gotoEntryPG(
				entryContent = "Blogs SDG Content Edited",
				entryTitle = "Blogs SDG Title Edited");

			BlogsEntry.viewEntryPG(
				entryContent = "Blogs SDG Content Edited",
				entryTitle = "Blogs SDG Title Edited");
		}
	}

	@description = "Can Search Blogs"
	@priority = 5
	test CanSearchBlogs {
		task ("Given the creation of a new blog") {
			BlogsNavigator.openBlogsAdmin(siteURLKey = "guest");
		}

		task ("And Two Blog Entries exists") {
			Blogs.addEntry(
				entryContent = "CE3235",
				entryTitle = "CE");

			Blogs.addEntry(
				entryContent = "DXP3536",
				entryTitle = "DXP");

			Navigator.gotoPage(pageName = "Blogs Page");
		}

		task ("When the User searches for Blog Entry 1") {
			SearchPortlets.searchEmbedded(searchTerm = "\"CE\"");
		}

		task ("Then Blog Entry 1 should display And Blog Entry 2 should not display") {
			SearchResultPortlet.viewSearchResults(
				searchAssetTitle = "CE",
				searchAssetType = "Blogs Entry",
				searchTerm = "\"CE\"");
		}
	}

}